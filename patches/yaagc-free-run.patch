 static void SimManageTime(void)
 {
+	/* --free-run: never wait for the wall clock.  The AGC's own sense of time comes from its
+	   cycle counter (TIME1/TIME2 are driven by the counter interrupts the engine generates),
+	   so running the engine as fast as the host allows keeps the simulation self-consistent;
+	   it only stops the host from sleeping between ticks.  Used by luminary-agent's stepped
+	   mode, where the pace is set by the caller's STEP commands, not by real time. */
+	if (Simulator.Options->free_run)
+	{
+		Simulator.DesiredCycles = Simulator.CycleCount + AGC_PER_SECOND;
+		return;
+	}
 	Simulator.RealTime = times (&Simulator.DummyTime);
 	if (Simulator.RealTime != Simulator.LastRealTime)
 	{
