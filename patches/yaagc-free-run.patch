+/* --- luminary-agent: deterministic stepping -------------------------------------------------
+   The client talks to the AGC over two unordered paths: channel packets over TCP and debugger
+   commands over the stdin pipe. Nothing said which arrives first, so the same episode gave
+   different results under load. Two barriers make the order explicit:
+
+   * SocketWaitBytes(n): before a STEP, wait until `n` bytes the client has sent in total have
+     arrived (consumed by the engine so far + still queued in the kernel). Only then does the AGC
+     start to run, so a packet "sent before STEP" is always there when the engine polls.
+   * SocketSendSync(): after a command finishes, before the prompt, put a marker packet (channel
+     0377) on every client socket. TCP keeps order, so once the client has read the marker it has
+     read everything the command made the AGC output. */
+unsigned long long SocketBytesReceived = 0;
+
+void
+SocketWaitBytes (unsigned long long Expected)
+{
+  int Tries, i;
+  for (Tries = 0; Tries < 40000; Tries++)  /* ~2 s at 50 us */
+    {
+      unsigned long long Queued = 0;
+      for (i = 0; i < MAX_CLIENTS; i++)
+	if (Clients[i].Socket != -1)
+	  {
+	    int Available = 0;
+	    if (0 == ioctl (Clients[i].Socket, FIONREAD, &Available) && Available > 0)
+	      Queued += Available;
+	  }
+      if (SocketBytesReceived + Queued >= Expected)
+	return;
+      usleep (50);
+    }
+}
+
+void
+SocketSendSync (void)
+{
+  static unsigned Seq = 0;
+  unsigned char Packet[4];
+  int i;
+  Seq = (Seq + 1) & 077777;
+  FormIoPacket (0377, Seq, Packet);
+  for (i = 0; i < MAX_CLIENTS; i++)
+    if (Clients[i].Socket != -1)
+      send (Clients[i].Socket, (const char *) Packet, 4, MSG_NOSIGNAL);
+}
+
